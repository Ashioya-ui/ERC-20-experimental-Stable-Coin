# Copy to .env (never commit .env). Used by the Makefile.

# Base mainnet RPC. A provider endpoint (Alchemy, QuickNode, Infura...) is recommended;
# https://mainnet.base.org works but is rate limited. Fork tests need archive access for
# old blocks; the latest block is enough by default.
BASE_RPC_URL=

# Etherscan API V2 key (one key covers Basescan): https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Fresh deployer account: holds ~0.002 ETH for gas and 2 USDC for the wsUSD dead-share seed
# on Base. It ends with no roles. Use it for nothing else while the deployment runs.
DEPLOYER=

# How forge signs: a Ledger (default) or an encrypted keystore created with
#   cast wallet import spectrum-deployer --interactive
SIGNER=--ledger
# SIGNER=--account spectrum-deployer

# Optional: pin the fork tests to a block.
# BASE_FORK_BLOCK=
