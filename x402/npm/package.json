{
  "name": "@pyzratio/x402-sessions",
  "version": "0.6.0",
  "description": "x402 payments for any AI agent: an MCP server that lets Claude, Cursor and other agents pay x402 APIs in USDC on Base within limits their owner sets, plus escrow-backed session vouchers with owner-capped budgets. Node.js only, no dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "x402-sessions": "x402/mcp.mjs",
    "x402-session-agent": "x402/agent.mjs",
    "x402-session-facilitator": "x402/facilitator.mjs",
    "x402-session-merchant": "x402/merchant.mjs"
  },
  "exports": {
    ".": "./x402/agent.mjs",
    "./agent": "./x402/agent.mjs",
    "./facilitator": "./x402/facilitator.mjs",
    "./merchant": "./x402/merchant.mjs",
    "./mcp": "./x402/mcp.mjs"
  },
  "files": [
    "x402/",
    "deployments/",
    "config/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashioya-ui/ERC-20-experimental-Stable-Coin.git",
    "directory": "x402"
  },
  "homepage": "https://github.com/Ashioya-ui/ERC-20-experimental-Stable-Coin/tree/main/x402#readme",
  "bugs": "https://github.com/Ashioya-ui/ERC-20-experimental-Stable-Coin/issues",
  "keywords": [
    "x402",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude",
    "payments",
    "micropayments",
    "payment-channel",
    "escrow",
    "usdc",
    "base",
    "http-402"
  ]
}
